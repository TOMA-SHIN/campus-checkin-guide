.container {
  padding: 24rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.form-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.form-input {
  height: 72rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  background-color: #fff;
}

.picker {
  height: 72rpx;
  line-height: 72rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  color: #999;
}

.picker.active {
  color: #333;
  border-color: #4CAF50;
}

.color-display {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.submit-btn {
  background-color: #4CAF50;
  color: #fff;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.color-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.color-picker {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 32rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 24rpx;
  z-index: 101;
  border-radius: 24rpx 24rpx 0 0;
}

.color-option {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}
